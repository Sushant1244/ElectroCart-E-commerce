# Environment variables for production deployment on Render.com
# Copy this file to .env and fill in your values

# PostgreSQL connection (Render provides this as POSTGRES_URL)
POSTGRES_URL=postgres://user:password@host:5432/database

# Node environment
NODE_ENV=production

# Port (Render sets this automatically)
PORT=10000

# Client URL (your Render app URL, e.g., https://your-app.onrender.com)
CLIENT_URL=https://your-app-name.onrender.com

# SMTP settings for email notifications
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
FROM_EMAIL=your-email@example.com

# Khalti payment settings (optional - only if using live keys)
KHALTI_LIVE_KEY=your_khalti_live_secret_key
KHALTI_LIVE_PUBLIC_KEY=your_khalti_live_public_key
KHALTI_SECRET_KEY=your_khalti_live_secret_key
KHALTI_ENV=production

# Sync PostgreSQL schema on startup (set to true on first deploy)
PG_SYNC=true
