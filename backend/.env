# Environment variables for backend
# PostgreSQL connection for Sequelize (username: postgres, password: root)
# Updated to use DB name without spaces to avoid URL-encoding issues
POSTGRES_URL=postgres://postgres:root@localhost:5432/electrocart_ecommerce

# =====================================================
# SMTP settings for Gmail - Order Confirmation Emails
# =====================================================
# IMPORTANT: Gmail requires an App-Specific Password, not your regular Gmail password
# To generate an App-Specific Password:
#   1. Go to your Google Account (myaccount.google.com)
#   2. Go to Security > 2-Step Verification (enable if not already)
#   3. Go to Security > App passwords (search for "app password")
#   4. Create a new app password for "Mail"
#   5. Use that 16-character password here as SMTP_PASS
#
# Gmail SMTP configuration - REPLACE the values below with your actual Gmail credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=rrag7927@gmail.com
SMTP_PASS=sxekgdzfsftgkfvs
FROM_EMAIL=rrag7927@gmail.com

# =====================================================
# Khalti (live) credentials - keep these secret
