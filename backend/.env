KHALTI_LIVE_KEY=c04d0cfbb4bd48479d2ae334eb2d7fbd
# Live public key (client side): used in front-end integration if needed
KHALTI_LIVE_PUBLIC_KEY=6d924a2e26d84ad6934b8593625dfea1
# Use production Khalti endpoints
KHALTI_ENV=production
KHALTI_SECRET_KEY=c04d0cfbb4bd48479d2ae334eb2d7fbd
