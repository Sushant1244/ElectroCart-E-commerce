{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/express",
      "config": {
        "maxDuration": 60
      }
    },
    {
      "src": "frontend",
      "use": "@vercel/static-build",
      "config": {
        "outputDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "backend/server.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
